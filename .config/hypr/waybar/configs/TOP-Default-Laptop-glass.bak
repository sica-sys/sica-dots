/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */

// ### DEFAULT Laptop  - Top ### //
{
  "custom/profil": { "format": "  󰀄  ", "tooltip-format": "Ma fiche", "on-click": "~/.config/hypr/scripts/ProfilCard.sh", "on-click-right": "python3 ~/FichePerso/pro/FichePro.py", "tooltip-format": "Clic gauche : fiche perso · clic droit : fiche pro" },
"include": [
	"$HOME/.config/hypr/waybar/ModulesAgenda",
  "$HOME/.config/hypr/waybar/Modules",
  "$HOME/.config/hypr/waybar/ModulesWorkspaces",
  "$HOME/.config/hypr/waybar/ModulesCustom",
  "$HOME/.config/hypr/waybar/ModulesGroups",
  "$HOME/.config/hypr/waybar/UserModules",
  ],
"custom/airpods": { "exec": "airpods-tui --waybar-watch", "return-type": "json", "format": "🎧 {}", "on-click": "kitty airpods-tui" },
"custom/hyprpicker": { "format": "󰈊", "tooltip": false, "on-click": "hyprpicker -a" },
"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 3,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
	"custom/separator#blank",
	"custom/hypr_layout",
	"custom/separator#blank",
	"custom/cava_mviz",
	"custom/separator#blank",
	"custom/playerctl",
	"hyprland/window",
	],

"modules-center": [
	"group/app_drawer",
	"custom/separator#blank",
	"group/notify",
	"hyprland/workspaces#rw",
	"group/heure", "clock#date",
	"custom/weather2",
	"idle_inhibitor",	
	"custom/hint",	
	],

"modules-right": [
"custom/airpods", "custom/separator#blank", "custom/profil",
"custom/hyprpicker",
	"tray",
	"group/laptop",
	"group/mobo_drawer",
	"group/audio",
	"custom/nightlight",
	"group/status",
	],
}
