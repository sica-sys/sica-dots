/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* Rofi Beats Config */

@import "~/.config/hypr/rofi/config.rasi" 

/* ---- Window ---- */
window {
  width: inherit;
  height: inherit;
}

/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "listview"];
}

/* ---- Entry ---- */ 
entry {
  placeholder: "📻 Choose Media or Stations to play";
}

/* ---- Listview ---- */
listview {
  columns: 2;
  lines: 7;
  fixed-height: false;
  margin: 10px;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
}

element-icon {
  size: 0%;
}

element-text {
  horizontal-align: 0.0;
  vertical-align: 0.5;
  margin: 0px;
  padding: 0px;
}
/* ===== Sélection violette (ajout) ===== */
element { border: 2px; border-color: transparent; border-radius: 12px; }
element selected.normal, element selected.active { background-color: rgba(198, 120, 221, 0.24); border-color: #c678dd; text-color: #ffffff; }
element-text, element-icon { background-color: transparent; text-color: inherit; }
