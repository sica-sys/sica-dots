/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* Main Config Calculator */
/* Submitted by: https://github.com/JosephArmas */

@import "~/.config/hypr/rofi/config.rasi" 

/* ---- Mainbox ---- */
mainbox {
  children: [ "entry", "message" ];
  height: inherit;
}

/* ---- Window ---- */
window {
  width: 30%;
  height: inherit;
}

/* ---- Entry ---- */
entry {
  expand: true;
  placeholder: " 🧮 Calculate";
}

listview {enable: false;}
/* ===== Sélection violette (ajout) ===== */
element { border: 2px; border-color: transparent; border-radius: 12px; }
element selected.normal, element selected.active { background-color: rgba(198, 120, 221, 0.24); border-color: #c678dd; text-color: #ffffff; }
element-text, element-icon { background-color: transparent; text-color: inherit; }

/* ===== override calculatrice : grande + lisible ===== */
window    { width: 45%; background-color: #1e1e2ef2; border: 2px; border-color: #89b4fa; border-radius: 14px; }
mainbox   { padding: 20px; spacing: 15px; background-color: transparent; children: [ inputbar, message ]; }
inputbar  { background-color: #313244; padding: 14px; border-radius: 10px; spacing: 10px; children: [ prompt, entry ]; }
prompt    { text-color: #89b4fa; background-color: transparent; font: "JetBrainsMono Nerd Font Bold 18"; }
entry     { text-color: #cdd6f4; background-color: transparent; font: "JetBrainsMono Nerd Font 18"; placeholder: "Tape un calcul (ex: 12*3+5)"; placeholder-color: #7f849c; }
message   { background-color: #313244; padding: 14px; border-radius: 10px; }
textbox   { text-color: #a6e3a1; background-color: transparent; font: "JetBrainsMono Nerd Font Bold 18"; }
