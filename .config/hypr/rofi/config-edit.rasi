/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* KooL Hyprland Edit Rofi Config */

@import "~/.config/hypr/rofi/config.rasi"  

/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "message", "listview"];
}


/* ---- Configuration ---- */ 
configuration {
  modi: "drun";
}

/* ---- Window ---- */
window {
   width: 70%;
   height: inherit;
}


/* ---- Listview ---- */
listview {
  columns: 3;
  lines: 6;
  fixed-height: false;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Entry input ---- */
entry {
  expand: true;
  placeholder: " 💫  Customize KooL Hyprland  💫";
  horizontal-align: 0.5;
}


/* ---- Elements ---- */
element {
  orientation: horizontal;
}

element-icon {
  size: 0%;
}
element-text {
  horizontal-align: 0.0;
  margin: 0px;
  padding: 0px;
}
/* ===== Sélection violette (ajout) ===== */
element { border: 2px; border-color: transparent; border-radius: 12px; }
element selected.normal, element selected.active { background-color: rgba(198, 120, 221, 0.24); border-color: #c678dd; text-color: #ffffff; }
element-text, element-icon { background-color: transparent; text-color: inherit; }
